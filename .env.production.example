# 生产环境配置模板：在服务器上另存为 /opt/hmail/.env 并填写真实值。
# 该文件由服务器侧手工维护，自动化部署不会覆盖它，也不要提交到 Git。

# CI 构建并推送到 GHCR 的后端镜像（必须小写）
# <owner> 取仓库地址中的账号名，例如仓库是 github.com/Glassous/Hmail，则填 ghcr.io/glassous/hmail-backend:latest
HMAIL_IMAGE=ghcr.io/your-github-owner/hmail-backend:latest

# 数据库密码：只用于生产数据库。数据库初始化后如需修改，必须同步更新数据库账户。
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# 加密 OAuth 令牌与 IMAP/SMTP 凭据，同时参与验证码摘要计算；丢失后无法解密现有绑定。
TOKEN_ENCRYPTION_KEY=generate-with-python-fernet

# 用户实际访问的 HTTPS 来源，不带结尾斜杠。写请求会与 Origin 做同源校验，必须精确一致。
PUBLIC_URL=https://hmail.fiacloud.top

# Google OAuth（可选，留空时前端仅提供 IMAP＋SMTP 连接）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 平台验证码发信通道（缺失任一必填项时注册与找回密码不可用）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM="Hmail <your-account@qq.com>"
